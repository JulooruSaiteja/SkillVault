# SkillVault Server Environment Variables
# Copy this file to .env in the server/ directory and fill in your values.
# Do NOT commit .env files with real secrets.

NODE_ENV=development
PORT=5000

# Client origin for CORS (Vite dev server URL)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/skillvault

# JWT authentication
JWT_SECRET=your_jwt_secret_key_placeholder
JWT_EXPIRES_IN=7d

# Cookie signing secret
COOKIE_SECRET=your_cookie_secret_key_placeholder

# Google Gemini API key (backend-only)
GEMINI_API_KEY=your_gemini_api_key_placeholder
