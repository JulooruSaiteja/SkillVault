# ==========================================
# SkillVault Environment Variables (Example)
# NOTE: Do NOT place real credentials or secrets here.
# Copy this file to .env and provide your local values.
# ==========================================

# ------------------------------------------
# Server Configuration
# ------------------------------------------
NODE_ENV=development
PORT=5000

# Client origin allowed by CORS (e.g. Vite dev server or production URL)
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# MongoDB connection URI (e.g. mongodb://localhost:27017/skillvault or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/skillvault

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Secret key used to sign and verify JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_placeholder

# JWT expiration window (e.g. 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d

# Cookie Secret (optional depending on cookie-parser setup)
COOKIE_SECRET=your_cookie_secret_key_placeholder

# ------------------------------------------
# External AI Services
# ------------------------------------------
# Google Gemini API key for generating learning paths, notes, and quizzes
GEMINI_API_KEY=your_gemini_api_key_placeholder

# ------------------------------------------
# Client Configuration (Vite)
# ------------------------------------------
# Base API URL used by the React client
VITE_API_BASE_URL=http://localhost:5000/api
